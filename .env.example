# Copy this file to .env for local development, and fill in your real
# Supabase values. On Railway/Vercel, set these same variables in that
# platform's dashboard instead (never commit an actual .env file).

# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used once by `npm run seed` to create the first admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Local dev only -- Railway/Vercel set this automatically.
PORT=3000

# Set to "production" on your real deployment (makes session cookies
# HTTPS-only). Leave unset or "development" for local use.
NODE_ENV=development
